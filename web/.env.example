# Copy this file to web/.env.local and fill it in. NEVER commit .env.local.
GEMINI_API_KEY=your-key-from-google-ai-studio
# Copy the current model name from the Google AI Studio quickstart:
GEMINI_MODEL=gemini-2.5-flash
# Your GoDaddy domain (used to build each agent's subdomain name):
NEXT_PUBLIC_APP_DOMAIN=yourdomain.xyz
# Only needed once agents are deployed somewhere other than localhost (e.g. Vultr):
# AGENT_URL_DINING=https://dining.yourdomain.xyz
# AGENT_URL_TRANSIT=https://transit.yourdomain.xyz
# AGENT_URL_EVENTS=https://events.yourdomain.xyz
# AGENT_URL_CAREERS=https://careers.yourdomain.xyz
